import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, DialogRow, DialogSection, Field, Modal, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { Check, Switch } from "../inspector/controls.slint";
import { NumberField } from "../primitives/number-field.slint";
import { PaneScroll } from "../workspace/pane.slint";

// Captions: what the tray's Captions tool opens.
//
// Two modes in one sheet ("Use voice from timeline"), plus VTS's full
// Auto-caption setup (inline model download, 99 Whisper languages, English
// translation with turbo fallback hint, collapsible Advanced options, manual
// blank/SRT/VTT start) and interactive Caption Editor (add/undo/save cues,
// 4-mode layout re-splitter, and "Use these captions → Detect sections").

export struct CaptionDraftData {
    text: string,
    start: float,
    end: float,
}

export struct CaptionsSheetData {
    open: bool,
    /// "Use voice from timeline": the words come from a clip's sound.
    from-voice: bool,
    /// The timeline's clips with sound, by file and start.
    sources: [string],
    /// Row in `sources` of the clip to transcribe; -1 for none.
    source: int,
    text: string,
    /// Row in the installed transcriber list.
    model: int,
    /// Downloadable Whisper models (`Get model` selector in autocaption.txt).
    download-models: [string],
    download-model: int,
    downloading-model: bool,
    download-progress: float,
    download-status: string,
    /// 0 faster-whisper (Python), 1 whisper.cpp (Vulkan GPU / CPU)
    engine: int,
    devices: [string],
    device: int,
    /// 0 auto, 1 int8, 2 int8_float16, 3 float16, 4 float32
    compute-type: int,
    vad-filter: bool,
    languages: [string],
    /// The language list as the search leaves it: -1 when the chosen one is hidden.
    language: int,
    /// The chosen language's label, shown on the trigger whatever the search hides.
    language-text: string,
    translate: bool,
    translate-hint: string,
    beam-size: float,
    prompt: string,
    output-dir: string,
    word-timestamps: bool,
    temperature-fallback: bool,
    normalize-audio: bool,
    keep-wav: bool,
    /// 0 Bottom, 1 Centre, 2 Top
    placement: int,
    /// 0 Small, 1 Medium, 2 Large
    size: int,
    /// 0 Default title style; 1..=8 the eight caption looks
    look-preset: int,
    running: bool,
    /// 0..1
    progress: float,
    progress-meta: string,
    /// A transcriber model is installed.
    ready: bool,
    reviewing: bool,
    can-undo: bool,
    /// 0 Engine, 1 Readable lines, 2 Burst (3 words), 3 One word at a time
    seg-preset: int,
    drafts: [CaptionDraftData],
    /// Why the last run failed, when it did.
    message: string,
}

export component CaptionsDialog inherits Modal {
    in property <CaptionsSheetData> data;
    /// The installed transcriber models, by name.
    in property <[string]> models;

    callback voice-toggled(on: bool);
    callback source-changed(index: int);
    callback text-edited(text: string);
    callback model-changed(index: int);
    callback download-model-changed(index: int);
    callback download-model-clicked();
    callback engine-changed(index: int);
    callback device-changed(index: int);
    callback compute-type-changed(index: int);
    callback vad-filter-changed(on: bool);
    callback language-changed(index: int);
    callback language-query-changed(text: string);
    callback translate-changed(on: bool);
    callback beam-size-changed(value: float);
    callback prompt-changed(text: string);
    callback output-dir-changed(text: string);
    callback browse-output-dir();
    callback word-timestamps-changed(on: bool);
    callback temperature-fallback-changed(on: bool);
    callback normalize-audio-changed(on: bool);
    callback keep-wav-changed(on: bool);
    callback placement-changed(index: int);
    callback size-changed(index: int);
    callback look-preset-changed(index: int);
    callback new-blank-captions();
    callback open-subtitle-file();
    callback draft-text-changed(index: int, text: string);
    callback draft-text-accepted(index: int, text: string, caret: int);
    callback draft-start-changed(index: int, value: float);
    callback draft-end-changed(index: int, value: float);
    callback draft-delete(index: int);
    callback draft-add();
    callback draft-undo();
    callback draft-save();
    callback seg-preset-changed(index: int);
    callback draft-resplit();
    callback draft-discard();
    callback draft-insert();
    callback draft-insert-new-track();
    callback draft-insert-and-detect();
    callback begin();
    callback cancel();

    property <bool> from-voice: root.data.from-voice;

    open: root.data.open;
    title: I18n.t("captions.captions");
    glyph: Glyph.text-mark;
    surface-width: root.data.reviewing ? 760px : 560px;
    surface-height: root.data.reviewing ? 580px : 0px;
    dismissable: !root.data.running;

    property <string> draft;
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.text;
        }
    }
    init => { root.draft = root.data.text; }

    VerticalLayout {
        if !root.data.running && !root.data.reviewing: HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 14px;
            spacing: 10px;

            Text {
                horizontal-stretch: 1;
                text: I18n.t("captions.useVoiceFromTimeline");
                color: Theme.fg;
                font-size: Theme.fs;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            VerticalLayout {
                alignment: center;
                Switch {
                    checked: root.from-voice;
                    toggled(on) => { root.voice-toggled(on); }
                }
            }
        }

        if !root.data.running && !root.data.reviewing && root.from-voice: DialogSection {
            first: true;
            title: I18n.t("common.transcriber");

            DialogRow {
                label: I18n.t("common.audio");
                Select {
                    options: root.data.sources;
                    current: root.data.source;
                    placeholder: I18n.t("captions.noVoiceOnTimeline");
                    enabled: root.data.sources.length > 0;
                    changed(index) => { root.source-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.model");
                Select {
                    options: root.models;
                    current: root.data.model;
                    placeholder: I18n.t("common.noneInstalled");
                    enabled: root.models.length > 0;
                    changed(index) => { root.model-changed(index); }
                }
            }

            // Inline model downloader (cDlModel, captionDlBtn, captionDlProgress, captionDlInfo)
            HorizontalLayout {
                spacing: 8px;

                Select {
                    horizontal-stretch: 1;
                    options: root.data.download-models;
                    current: root.data.download-model;
                    enabled: !root.data.downloading-model && root.data.download-models.length > 0;
                    changed(index) => { root.download-model-changed(index); }
                }

                Button {
                    label: I18n.t("captions.getModel");
                    enabled: !root.data.downloading-model && root.data.download-models.length > 0;
                    clicked => { root.download-model-clicked(); }
                }
            }

            if root.data.downloading-model: Progress {
                value: root.data.download-progress;
            }

            if root.data.download-status != "": Text {
                text: root.data.download-status;
                color: Theme.fg-muted;
                font-size: Theme.fs-xs;
                wrap: word-wrap;
            }

            DialogRow {
                label: I18n.t("captions.engine");
                Select {
                    options: [
                        "faster-whisper (Python)",
                        "whisper.cpp (Vulkan GPU / CPU)",
                    ];
                    current: root.data.engine;
                    changed(index) => { root.engine-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.device");
                Select {
                    options: root.data.devices;
                    current: root.data.device;
                    changed(index) => { root.device-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.language");
                Select {
                    options: root.data.languages;
                    current: root.data.language;
                    value-text: root.data.language-text;
                    searchable: true;
                    search-placeholder: I18n.t1("common.searchKind", I18n.t("captions.language"));
                    changed(index) => { root.language-changed(index); }
                    query-changed(text) => { root.language-query-changed(text); }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    text: I18n.t("captions.translateEnglish");
                    color: Theme.fg;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: root.data.translate;
                        toggled(on) => { root.translate-changed(on); }
                    }
                }
            }

            if root.data.translate-hint != "": Text {
                text: root.data.translate-hint;
                color: Theme.fg-dim;
                font-size: Theme.fs-xs;
                wrap: word-wrap;
            }
        }

        // Collapsible Advanced options (autocaption.txt lines 134-154)
        if !root.data.running && !root.data.reviewing && root.from-voice: DialogSection {
            collapsible: true;
            open: false;
            title: I18n.t("captions.advancedOptions");

            DialogRow {
                label: I18n.t("captions.computeType");
                Select {
                    options: ["auto", "int8", "int8_float16", "float16", "float32"];
                    current: root.data.compute-type;
                    changed(index) => { root.compute-type-changed(index); }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;
                    width: 150px;
                    Text {
                        text: I18n.t("captions.beamSize");
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                    NumberField {
                        horizontal-stretch: 1;
                        value: root.data.beam-size;
                        minimum: 1;
                        maximum: 10;
                        step: 1;
                        precision: 0;
                        changed(v) => { root.beam-size-changed(v); }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Text {
                        text: I18n.t("captions.prompt");
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                    Field {
                        horizontal-stretch: 1;
                        value: root.data.prompt;
                        placeholder: I18n.t("captions.promptHint");
                        edited(text) => { root.prompt-changed(text); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: I18n.t("captions.outputFolder");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }

                Field {
                    horizontal-stretch: 1;
                    value: root.data.output-dir;
                    placeholder: I18n.t("captions.outputDirPlaceholder");
                    edited(text) => { root.output-dir-changed(text); }
                }

                Button {
                    label: I18n.t("common.browse");
                    clicked => { root.browse-output-dir(); }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Check {
                            checked: root.data.vad-filter;
                            toggled => { root.vad-filter-changed(!root.data.vad-filter); }
                        }
                    }
                    Text {
                        text: I18n.t("captions.vadFilter");
                        color: Theme.fg;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Check {
                            checked: root.data.word-timestamps;
                            toggled => { root.word-timestamps-changed(!root.data.word-timestamps); }
                        }
                    }
                    Text {
                        text: I18n.t("captions.wordTimestamps");
                        color: Theme.fg;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Check {
                            checked: root.data.temperature-fallback;
                            toggled => { root.temperature-fallback-changed(!root.data.temperature-fallback); }
                        }
                    }
                    Text {
                        text: I18n.t("captions.temperatureFallback");
                        color: Theme.fg;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Check {
                            checked: root.data.normalize-audio;
                            toggled => { root.normalize-audio-changed(!root.data.normalize-audio); }
                        }
                    }
                    Text {
                        text: I18n.t("captions.normalizeAudio");
                        color: Theme.fg;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Check {
                            checked: root.data.keep-wav;
                            toggled => { root.keep-wav-changed(!root.data.keep-wav); }
                        }
                    }
                    Text {
                        text: I18n.t("captions.keepWav");
                        color: Theme.fg;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if !root.data.running && !root.data.reviewing && !root.from-voice: DialogSection {
            first: true;
            title: I18n.t("common.script");

            Rectangle {
                height: 104px;
                border-radius: Theme.r;
                background: Theme.well;
                border-width: 1px;
                border-color: script.has-focus ? Theme.accent : Theme.line;
                clip: true;

                script := TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    text <=> root.draft;
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    single-line: false;
                    wrap: word-wrap;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    changed has-focus => { root.typing = self.has-focus; }
                    edited => { root.text-edited(self.text); }
                    key-pressed(event) => {
                        if (event.text == Key.Home) {
                            self.set-selection-offsets(0, 0);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            self.set-selection-offsets(1000000000, 1000000000);
                            return accept;
                        }
                        return reject;
                    }
                }

                if root.draft == "" && !script.has-focus: Text {
                    x: 10px;
                    y: 8px;
                    text: I18n.t("captions.typeWordsPutScreen");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-lg;
                }
            }
        }

        if !root.data.running && !root.data.reviewing: DialogSection {
            title: I18n.t("captions.captions");

            DialogRow {
                label: I18n.t("captions.placement");
                SegmentedControl {
                    options: [I18n.t("common.bottom"), I18n.t("captions.centre"), I18n.t("common.top")];
                    current: root.data.placement;
                    changed(index) => { root.placement-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.size");
                SegmentedControl {
                    options: [I18n.t("common.small"), I18n.t("common.medium"), I18n.t("common.large")];
                    current: root.data.size;
                    changed(index) => { root.size-changed(index); }
                }
            }

            DialogRow {
                label: "Look";
                Select {
                    width: 240px;
                    options: [
                        "Default",
                        "Pop bold",
                        "Boxed",
                        "Karaoke",
                        "Minimal",
                        "Hard shadow",
                        "Upper tight",
                        "Low third",
                        "Clean bilingual",
                    ];
                    current: root.data.look-preset;
                    changed(index) => { root.look-preset-changed(index); }
                }
            }

            Text {
                text: root.from-voice
                    ? I18n.t("captions.oneTitlePerPhrase")
                    : I18n.t("captions.oneTitlePerSentence");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        // Caption Editor (autocaption.txt lines 163-196)
        if root.data.reviewing: VerticalLayout {
            vertical-stretch: 1;
            padding: 14px;
            spacing: 8px;

            // Header bar: Caption editor (N cues) | + Add cue | Undo changes | Save captions
            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: I18n.t("captions.captionEditor");
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    font-weight: Theme.weight-title;
                    vertical-alignment: center;
                }

                Text {
                    text: "(\{root.data.drafts.length} " + I18n.t("captions.cues") + ")";
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    label: "+ " + I18n.t("captions.addCue");
                    clicked => { root.draft-add(); }
                }

                Button {
                    label: I18n.t("captions.undoChanges");
                    enabled: root.data.can-undo;
                    clicked => { root.draft-undo(); }
                }

                Button {
                    label: I18n.t("captions.saveCaptions");
                    enabled: root.data.drafts.length > 0;
                    clicked => { root.draft-save(); }
                }

                Button {
                    label: I18n.t("sections.addCaptionsToTimeline");
                    primary: true;
                    enabled: root.data.drafts.length > 0;
                    clicked => { root.draft-insert(); }
                }
            }

            // Layout re-splitter bar (cSeg + Re-split button + hint)
            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: I18n.t("captions.layout");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }

                Select {
                    width: 240px;
                    options: [
                        I18n.t("captions.segEngine"),
                        I18n.t("captions.segLine"),
                        I18n.t("captions.segBurst"),
                        I18n.t("captions.segWord"),
                    ];
                    current: root.data.seg-preset;
                    changed(index) => { root.seg-preset-changed(index); }
                }

                Button {
                    label: I18n.t("captions.resplit");
                    enabled: root.data.drafts.length > 0;
                    clicked => { root.draft-resplit(); }
                }

                Text {
                    horizontal-stretch: 1;
                    text: I18n.t("captions.layoutHint");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Cue table header (# | Start (s) | End (s) | Text | del)
            Rectangle {
                height: 24px;
                background: Theme.raised;
                border-radius: Theme.r-sm;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 12px;
                    spacing: 6px;

                    Text {
                        width: 28px;
                        text: "#";
                        color: Theme.fg-dim;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }

                    Text {
                        width: 86px;
                        text: I18n.t("captions.colStartSec");
                        color: Theme.fg-dim;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }

                    Text {
                        width: 86px;
                        text: I18n.t("captions.colEndSec");
                        color: Theme.fg-dim;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: I18n.t("captions.colText");
                        color: Theme.fg-dim;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }

                    Rectangle { width: 44px; }
                }
            }

            PaneScroll {
                min-height: 240px;
                vertical-stretch: 1;
                finger: true;
                VerticalLayout {
                    spacing: 4px;
                    padding-right: 6px;
                    for cue[index] in root.data.drafts: Rectangle {
                        min-height: 38px;
                        background: Math.mod(index, 2) == 0 ? Theme.well : Theme.raised;
                        border-radius: Theme.r-sm;
                        HorizontalLayout {
                            padding: 5px;
                            spacing: 6px;
                            Text {
                                width: 28px;
                                text: "\{index + 1}";
                                color: Theme.fg-dim;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                            }
                            NumberField {
                                width: 86px;
                                value: cue.start;
                                minimum: 0;
                                maximum: 100000;
                                step: 0.05;
                                precision: 3;
                                unit: "s";
                                changed(value) => { root.draft-start-changed(index, value); }
                            }
                            NumberField {
                                width: 86px;
                                value: cue.end;
                                minimum: 0;
                                maximum: 100000;
                                step: 0.05;
                                precision: 3;
                                unit: "s";
                                changed(value) => { root.draft-end-changed(index, value); }
                            }
                            Field {
                                horizontal-stretch: 1;
                                value: cue.text;
                                placeholder: I18n.t("captions.captionText");
                                edited(text) => { root.draft-text-changed(index, text); }
                                accepted(text, caret) => {
                                    root.draft-text-accepted(index, text, caret);
                                }
                            }
                            Button {
                                label: "×";
                                danger: true;
                                ghost: true;
                                clicked => { root.draft-delete(index); }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            if root.data.message != "": Rectangle {
                border-radius: Theme.r;
                background: Theme.danger-soft;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.message;
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: start;
                        CopyChip { text: root.data.message; }
                    }
                }
            }

            if root.data.running: HorizontalLayout {
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: root.data.progress < 0.02 ? I18n.t("captions.loadingTheModel") : I18n.t("captions.transcribing");
                    color: Theme.fg;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                }

                Text {
                    text: root.data.progress-meta != "" ? root.data.progress-meta : "\{Math.round(root.data.progress * 100)}%";
                    color: Theme.fg-muted;
                    font-family: Theme.font-technical;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }
            }

            if root.data.running: Progress { value: root.data.progress; }

            if root.data.running: HorizontalLayout {
                alignment: start;
                Button {
                    label: I18n.t("common.cancel");
                    glyph: Glyph.close;
                    ghost: true;
                    clicked => { root.cancel(); }
                }
            }

            if !root.data.running && root.data.reviewing: HorizontalLayout {
                spacing: 8px;

                Button {
                    label: I18n.t("captions.discardDraft");
                    ghost: true;
                    clicked => { root.draft-discard(); }
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    label: I18n.t("captions.useCaptions");
                    large: true;
                    enabled: root.data.drafts.length > 0;
                    clicked => { root.draft-insert(); }
                }

                Button {
                    label: I18n.t("captions.addAsNewCaptionTrack");
                    large: true;
                    enabled: root.data.drafts.length > 0;
                    clicked => { root.draft-insert-new-track(); }
                }

                Button {
                    label: I18n.t("captions.useCaptionsDetect");
                    primary: true;
                    large: true;
                    enabled: root.data.drafts.length > 0;
                    clicked => { root.draft-insert-and-detect(); }
                }
            }

            if !root.data.running && !root.data.reviewing: HorizontalLayout {
                spacing: 8px;

                Button {
                    horizontal-stretch: 1;
                    primary: true;
                    large: true;
                    glyph: Glyph.text-mark;
                    label: root.from-voice ? I18n.t("captions.generateCaptions") : I18n.t("captions.addCaptions");
                    enabled: root.from-voice ? root.data.ready && root.data.source >= 0 : root.draft != "";
                    clicked => { root.begin(); }
                }

                Button {
                    large: true;
                    label: I18n.t("captions.newBlankCaptions");
                    clicked => { root.new-blank-captions(); }
                }

                Button {
                    large: true;
                    label: I18n.t("captions.openSubtitleFile");
                    clicked => { root.open-subtitle-file(); }
                }
            }
        }
    }
}
