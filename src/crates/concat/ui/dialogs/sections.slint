import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph } from "../icons.slint";
import { Button, DialogRow, DialogSection, Modal } from "../primitives/modal.slint";
import { NumberField } from "../primitives/number-field.slint";
import { SearchField, Switch } from "../inspector/controls.slint";
import { PaneScroll } from "../workspace/pane.slint";

// The Sections sheet: a clip overview, an aligned timeline strip, and one
// card per caption, silence or uncovered span. The card and timeline share
// the same normalized start/end values, so a card always points at the block
// it represents rather than a second, separately computed clock.
export struct SectionRowData {
    source-index: int,
    /// "Caption", "Silence" or "Other", in the interface's language.
    kind: string,
    /// The caption's words, or the kind again for a wordless row.
    label: string,
    /// The row's timeline in/out points.
    range: string,
    /// Ticked: this row survives the autotrim.
    keep: bool,
    /// 0 caption, 1 silence, 2 other; a visual key for the strip.
    kind-code: int,
    /// Normalized positions in the clip-wide strip, in 0..1.
    start-ratio: float,
    end-ratio: float,
}

export struct SectionsSheetData {
    open: bool,
    running: bool,
    noise-db: float,
    min-silence-ms: float,
    min-section-ms: float,
    use-captions: bool,
    search: string,
    min-duration: float,
    show-caption: bool,
    show-silence: bool,
    show-other: bool,
    /// The clip being listed, by file and timeline start.
    clip-label: string,
    /// "2 captions · 3 silences · 1 other".
    summary: string,
    /// "Keeping 0:42 / 1:00".
    kept-label: string,
    /// Range covered by the clip on the timeline.
    timeline-start: string,
    timeline-end: string,
    /// Why the last run failed, when it did.
    message: string,
    /// The ticks can be applied as a trim.
    can-apply: bool,
    rows: [SectionRowData],
}

component SectionTimeline inherits Rectangle {
    in property <[SectionRowData]> rows;

    horizontal-stretch: 1;
    min-height: 20px;
    max-height: 20px;
    border-radius: Theme.r-sm;
    background: Theme.well;
    clip: true;

    for row in root.rows: Rectangle {
        x: root.width * row.start-ratio;
        width: Math.max(2px, root.width * (row.end-ratio - row.start-ratio));
        y: 3px;
        height: 14px;
        border-radius: 2px;
        background: row.kind-code == 0 ? Theme.accent
            : row.kind-code == 1 ? Theme.field-active
            : Theme.green;
        opacity: row.keep ? 1.0 : 0.55;
    }
}

component SectionCard inherits Rectangle {
    in property <SectionRowData> section-item;

    callback toggle-keep();

    border-radius: Theme.r;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.line-strong : Theme.line;
    background: root.section-item.keep ? Theme.raised : Theme.well;
    clip: true;

    animate background, border-color {
        duration: 120ms;
        easing: cubic-bezier(0.4, 0, 0.2, 1);
    }

    touch := TouchArea {
        // Cards are read-only except for the explicit keep switch. This area
        // gives a quiet hover affordance without stealing the switch press.
        mouse-cursor: default;
    }

    Rectangle {
        width: 3px;
        height: parent.height;
        background: root.section-item.kind-code == 0 ? Theme.accent
            : root.section-item.kind-code == 1 ? Theme.field-active
            : Theme.green;
    }

    VerticalLayout {
        padding: 9px;
        padding-left: 12px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 4px;
                background: root.section-item.kind-code == 0 ? Theme.accent
                    : root.section-item.kind-code == 1 ? Theme.field-active
                    : Theme.green;
            }

            Text {
                text: root.section-item.kind;
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.section-item.range;
                color: Theme.fg-dim;
                font-family: Theme.font-technical;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                Switch {
                    checked: root.section-item.keep;
                    toggled(on) => { root.toggle-keep(); }
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.section-item.label;
            color: root.section-item.keep ? Theme.fg : Theme.fg-dim;
            font-size: Theme.fs;
            wrap: word-wrap;
        }
    }

}

export component SectionsDialog inherits Modal {
    in property <SectionsSheetData> data;

    callback row-toggled(index: int);
    callback detect();
    callback threshold-changed(value: float);
    callback min-silence-changed(value: float);
    callback min-section-changed(value: float);
    callback use-captions-changed(on: bool);
    callback search-changed(text: string);
    callback min-duration-changed(value: float);
    callback kind-toggled(kind: int);
    callback select-visible();
    callback select-none();
    callback select-invert();
    callback select-all-silence();
    callback select-all-captions();
    callback apply();

    open: root.data.open;
    title: I18n.t("sections.sections");
    glyph: Glyph.rows;
    surface-width: 760px;
    surface-height: 620px;
    dismissable: !root.data.running;

    VerticalLayout {
        padding: 13px;
        spacing: 9px;

        Text {
            text: root.data.clip-label;
            color: Theme.fg;
            font-size: Theme.fs;
            wrap: word-wrap;
        }

        if root.data.summary != "": Text {
            text: root.data.summary;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        if !root.data.running: DialogSection {
            first: true;
            title: I18n.t("sections.detectSections");

            DialogRow {
                label: I18n.t("sections.threshold");
                NumberField {
                    value: root.data.noise-db;
                    minimum: -100;
                    maximum: 0;
                    step: 1;
                    precision: 0;
                    unit: "dB";
                    changed(value) => { root.threshold-changed(value); }
                }
            }
            DialogRow {
                label: I18n.t("sections.minSilence");
                NumberField {
                    value: root.data.min-silence-ms;
                    minimum: 0;
                    maximum: 60000;
                    step: 50;
                    precision: 0;
                    unit: "ms";
                    changed(value) => { root.min-silence-changed(value); }
                }
            }
            DialogRow {
                label: I18n.t("sections.minSection");
                NumberField {
                    value: root.data.min-section-ms;
                    minimum: 0;
                    maximum: 60000;
                    step: 10;
                    precision: 0;
                    unit: "ms";
                    changed(value) => { root.min-section-changed(value); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: I18n.t("sections.useCaptions");
                    color: Theme.fg;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: root.data.use-captions;
                        toggled(on) => { root.use-captions-changed(on); }
                    }
                }
            }
            Button {
                label: I18n.t("sections.detectSections");
                glyph: Glyph.rows;
                primary: true;
                clicked => { root.detect(); }
            }
        }

        if root.data.rows.length > 0: VerticalLayout {
            spacing: 5px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: I18n.t("sections.timeline");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.data.timeline-start;
                    color: Theme.fg-dim;
                    font-family: Theme.font-technical;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }

                Text {
                    text: "–";
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }

                Text {
                    text: root.data.timeline-end;
                    color: Theme.fg-dim;
                    font-family: Theme.font-technical;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }
            }

            SectionTimeline { rows: root.data.rows; }
        }

        if root.data.running: Text {
            text: I18n.t("sections.listening");
            color: Theme.fg;
            font-size: Theme.fs;
        }

        if root.data.message != "": Text {
            text: root.data.message;
            color: Theme.danger;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        if root.data.rows.length > 0: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                Button { label: I18n.t("sections.caption"); ghost: !root.data.show-caption; clicked => { root.kind-toggled(0); } }
                Button { label: I18n.t("sections.silence"); ghost: !root.data.show-silence; clicked => { root.kind-toggled(1); } }
                Button { label: I18n.t("sections.other"); ghost: !root.data.show-other; clicked => { root.kind-toggled(2); } }
                NumberField {
                    width: 110px;
                    value: root.data.min-duration;
                    minimum: 0;
                    maximum: 3600;
                    step: 0.1;
                    precision: 1;
                    unit: "s";
                    changed(value) => { root.min-duration-changed(value); }
                }
                SearchField {
                    horizontal-stretch: 1;
                    text: root.data.search;
                    placeholder: I18n.t("sections.searchCaptions");
                    edited(text) => { root.search-changed(text); }
                }
            }
            HorizontalLayout {
                spacing: 5px;
                Button { label: I18n.t("sections.selectVisible"); ghost: true; clicked => { root.select-visible(); } }
                Button { label: I18n.t("sections.clearSelection"); ghost: true; clicked => { root.select-none(); } }
                Button { label: I18n.t("sections.invertSelection"); ghost: true; clicked => { root.select-invert(); } }
                Button { label: I18n.t("sections.allSilence"); ghost: true; clicked => { root.select-all-silence(); } }
                Button { label: I18n.t("sections.allCaptions"); ghost: true; clicked => { root.select-all-captions(); } }
            }
        }

        PaneScroll {
            vertical-stretch: 1;
            finger: true;

            for row[index] in root.data.rows: SectionCard {
                section-item: row;
                toggle-keep => { root.row-toggled(row.source-index); }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }

        HorizontalLayout {
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                text: root.data.kept-label;
                color: Theme.fg;
                font-size: Theme.fs;
                vertical-alignment: center;
            }

            Button {
                label: I18n.t("sections.apply");
                glyph: Glyph.razor;
                primary: true;
                enabled: root.data.can-apply;
                clicked => { root.apply(); }
            }

            Button {
                label: I18n.t("common.close");
                glyph: Glyph.close;
                ghost: true;
                clicked => { root.closed(); }
            }
        }
    }
}
