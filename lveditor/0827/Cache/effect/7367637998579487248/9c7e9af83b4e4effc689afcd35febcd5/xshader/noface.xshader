%YAML 1.1
--- !XShader &1
name: !<str> Glow
renderQueue: 3090
passes:
  - __class: Pass
    name: !<str> ""
    shaders:
      __class: Map
      gles2:
        - {localId: 20}
        - {localId: 21}
    angleBinaryPrograms:
      __class: Map
    semantics:
      __class: Map
      a_position:
        __class: VertexAttribType
        value: POSITION
      a_texcoord0:
        __class: VertexAttribType
        value: USER_DEFINE1
      a_color:
        __class: VertexAttribType
        value: COLOR
      a_bloomPara:
        __class: VertexAttribType
        value: COLOR1
      a_bloomPara2:
        __class: VertexAttribType
        value: COLOR2
    renderTexture: {localId: 1, path: rt/BlurRT_1.rt}
    clearColor: {r: 0, g: 0, b: 0, a: 0}
    clearDepth: 1
    clearType:
      __class: CameraClearType
      value: COLOR
    renderState:
      __class: RenderState
      name: !<str> ""
      depthstencil:
        __class: DepthStencilState
        name: !<str> ""
        depthTestEnable: false
        depthTestEnableName: !<str> ""
        depthCompareOp:
          __class: CompareOp
          value: LESS
        depthCompareOpName: !<str> ""
        depthWriteEnable: false
        stencilTestEnable: false
        stencilTestEnableName: !<str> ""
    useFBOTexture: false
    useCameraRT: false
    useFBOFetch: false
    enableFBOFetch: false
    isFullScreenShading: false
    macrosMap:
      __class: Map
    preprocess: false
    passType:
      __class: PassType
      value: NORMAL
    lightMode:
      __class: LightMode
      value: NONE
    clearMoment:
      __class: PassClearMoment
      value: CLEAR_BEFORE_RENDERING
    instanceCount: 0
    auslSourcePath: !<str> ""
