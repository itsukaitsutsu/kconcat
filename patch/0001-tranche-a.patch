+        let words = &remapped[0].words;
+        assert_eq!(
+            words,
+            &vec![
+                word("one", 0.0, 1.0),
+                // Clipped by the first range, then clipped by the second:
+                // heard on both sides of a join that removes nothing.
+                word("two", 2.0, 2.5),
